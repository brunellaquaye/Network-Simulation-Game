// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  password  String
  role      String   @default("player") // 'admin' or 'player'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenarios    Scenario[]
  states       State[]
  leaderboards Leaderboard[]
}

enum difficulty{
  easy
  medium
  hard
}
model Scenario {
  id         Int      @id @default(autoincrement())
  name       String
  difficulty difficulty   @default(easy) //easy, medium, hard
  timeLimit  Int
  createdAt  DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  devices      Device[]
  leaderboards Leaderboard[]
}
enum Status{
  online
  offline
}
// add position x and y for each device
model Device {
  id          Int      @id @default(autoincrement())
  name        String
  type        String // router, switch, server, load balancer, workstation, firewall, access point
  ipAddress   String?   
  pingRate    Float    @default(10)
  latency     Float    @default(50)
  trafficLoad Float    @default(12)
  status      Status   @default(online) // online/offline
  lastUpdated DateTime @default(now())

  scenarioId Int
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  logs Log[]
   @@unique([scenarioId, ipAddress])

  // Canvas Position as JSON
  position      Json?         // { "x": 250.5, "y": 180.3 }

  // Relations
  connections   Device[]      @relation("DeviceConnections")
  connectedTo   Device[]      @relation("DeviceConnections")

  createdById   Int?
  // createdBy     User?         @relation(fields: [createdById], references: [id])
}

model Log {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  eventType String
  message   String
}

model Leaderboard {
  id         Int      @id @default(autoincrement())
  playerName String
  score      Int
  timestamp  DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  scenarioId Int
  scenario   Scenario @relation(fields: [scenarioId], references: [id])
}

model State {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  data      Json
  version   Int
  createdAt DateTime @default(now())
}
