generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
 * ENUMS
 */
enum Role {
  player
  admin
  superadmin
}

enum Status {
  online
  offline
}

enum Difficulty {
  easy
  medium
  hard
}

/*
 * USER MANAGEMENT
 */
model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  username     String
  password     String
  role         Role         @default(player)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  scenarios    Scenario[]
  sessions     SimulationSession[]
  leaderboards Leaderboard[]
}

/*
 * SCENARIOS
 */
model Scenario {
  id           Int          @id @default(autoincrement())
  name         String
  difficulty   Difficulty    @default(easy)
  timeLimit    Int
  createdAt    DateTime      @default(now())

  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  devices      Device[]
  sessions     SimulationSession[]
  leaderboards Leaderboard[]
}

/*
 * DEVICES
 */
model Device {
  id           Int          @id @default(autoincrement())
  name         String
  type         String
  ipAddress    String?
  pingRate     Float         @default(10)
  latency      Float         @default(50)
  trafficLoad  Float         @default(12)
  status       Status        @default(online)
  lastUpdated  DateTime      @default(now())

  scenarioId   Int
  scenario     Scenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  position     Json?         // { x: 200, y: 120 }

  outgoing     DeviceConnection[] @relation("from")
  incoming     DeviceConnection[] @relation("to")

  @@unique([scenarioId, ipAddress])
}

/*
 * DEVICE CONNECTIONS (for network visualization)
 */
model DeviceConnection {
  id        Int      @id @default(autoincrement())
  fromId    Int
  toId      Int
  createdAt DateTime @default(now())

  from      Device   @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to        Device   @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

/*
 * SIMULATION SESSIONS (Player-side clones of scenarios)
 */
model SimulationSession {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  scenarioId  Int
  scenario    Scenario      @relation(fields: [scenarioId], references: [id])
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  isActive    Boolean       @default(true)
  score       Int           @default(0)
  lastState   Json?

  devices     SessionDevice[]
  logs        Log[]
}

/*
 * SESSION DEVICES (isolated from real devices)
 */
model SessionDevice {
  id           Int       @id @default(autoincrement())
  sessionId    Int
  session      SimulationSession @relation(fields: [sessionId], references: [id])
  name         String
  type         String
  ipAddress    String?
  pingRate     Float
  latency      Float
  trafficLoad  Float
  status       Status      @default(online)
  lastUpdated  DateTime    @default(now())

  logs         Log[]       @relation("DeviceLogs")
}

/*
 * LOGS (Unified System)
 */
model Log {
  id          Int       @id @default(autoincrement())
  sessionId   Int
  session     SimulationSession @relation(fields: [sessionId], references: [id])
  deviceId    Int?      
  device      SessionDevice? @relation("DeviceLogs", fields: [deviceId], references: [id])
  timestamp   DateTime  @default(now())
  eventType   String
  message     String
}

/*
 * LEADERBOARD
 */
model Leaderboard {
  id         Int       @id @default(autoincrement())
  playerName String
  score      Int
  timestamp  DateTime  @default(now())

  userId     Int
  user       User      @relation(fields: [userId], references: [id])

  scenarioId Int
  scenario   Scenario  @relation(fields: [scenarioId], references: [id])
}
